@page "{id}"
@model WebApplication1.Pages.Items.DetailsModel
@{
	ViewData["Title"] = "Item details";
}
@if (Model.Item is null)
{
	<div class="alert alert-danger">The item could not be found.</div>
}
else
{
	<div class="d-flex justify-content-between align-items-start mb-4"><div><p class="eyebrow">Item record</p><h1>@Model.Item.Name</h1></div><span class="badge text-bg-secondary fs-6">@Model.Item.Status</span></div>
	<div class="card shadow-sm border-0">@if (!string.IsNullOrWhiteSpace(Model.Item.ImageUrl)){<img src="@Model.Item.ImageUrl" class="card-img-top" alt="Photo of @Model.Item.Name" style="max-height: 420px; object-fit: contain;" />}<div class="card-body"><dl class="row mb-0"><dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.Item.Type</dd><dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.Item.Category</dd><dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Item.Description</dd><dt class="col-sm-3">Location</dt><dd class="col-sm-9">@Model.Item.Location</dd><dt class="col-sm-3">Reported</dt><dd class="col-sm-9">@Model.Item.DateReported.ToString("yyyy-MM-dd")</dd></dl></div></div>
	<div class="mt-4 d-flex gap-2"><a class="btn btn-outline-secondary" asp-page="/Index">Back to records</a>@if (Model.CanClaim){<a class="btn btn-primary" asp-page="/Claims/Create" asp-route-itemId="@Model.Item.ItemId">Submit a claim</a>}</div>
}
