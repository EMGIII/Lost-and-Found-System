@page
@model WebApplication1.Pages.Items.ReportLostModel
@{
	ViewData["Title"] = "Report a lost item";
}
<h1>Report a lost item</h1><p class="text-muted">Provide enough detail for the campus community to recognize the item.</p>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form method="post" enctype="multipart/form-data" class="card shadow-sm border-0"><div class="card-body"><div class="row g-3"><div class="col-md-6"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Input.Category" class="form-label"></label><select asp-for="Input.Category" class="form-select"><option value="">Select a category</option><option>Electronics</option><option>Clothing</option><option>Documents</option><option>Keys</option><option>Wallet or purse</option><option>Books and school supplies</option><option>Jewelry</option><option>Other</option></select><span asp-validation-for="Input.Category" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Input.Location" class="form-label"></label><input asp-for="Input.Location" class="form-control" /><span asp-validation-for="Input.Location" class="text-danger"></span></div><div class="col-12"><label asp-for="Input.Description" class="form-label"></label><textarea asp-for="Input.Description" class="form-control" rows="4"></textarea><span asp-validation-for="Input.Description" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Input.DateLost" class="form-label"></label><input asp-for="Input.DateLost" class="form-control" type="date" /><span asp-validation-for="Input.DateLost" class="text-danger"></span></div><div class="col-md-8"><label asp-for="Input.Image" class="form-label"></label><input asp-for="Input.Image" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp" /><div class="form-text">JPEG, PNG, GIF, or WebP up to 5 MB.</div><span asp-validation-for="Input.Image" class="text-danger"></span></div></div></div><div class="card-footer bg-white"><button class="btn btn-primary">Submit lost-item report</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
