@page
@model WebApplication1.Pages.Claims.MyModel
@{
	ViewData["Title"] = "My reports and claims";
}
<h1>My activity</h1>@if (TempData["Message"] is string message){<div class="alert alert-success">@message</div>}<div class="row g-4"><div class="col-lg-6"><h2 class="h5">My item reports</h2>@if(Model.Reports.Count == 0){<p class="text-muted">You have not submitted an item report.</p>}else{<div class="list-group">@foreach(var item in Model.Reports){<a class="list-group-item list-group-item-action d-flex justify-content-between" asp-page="/Items/Details" asp-route-id="@item.ItemId"><span>@item.Name</span><span class="badge text-bg-secondary">@item.Status</span></a>}</div>}</div><div class="col-lg-6"><h2 class="h5">My claims</h2>@if(Model.Claims.Count == 0){<p class="text-muted">You have not submitted a claim.</p>}else{<div class="list-group">@foreach(var claim in Model.Claims){var item = Model.GetClaimedItem(claim.ItemId);<div class="list-group-item"><div class="d-flex justify-content-between gap-2"><a asp-page="/Items/Details" asp-route-id="@claim.ItemId">@(item?.Name ?? claim.ItemId)</a><span class="badge text-bg-secondary">@claim.Status</span></div><div class="small text-muted mt-1">Submitted @claim.SubmittedDate.ToString("MMM d, yyyy") · Claim ID: @claim.ClaimId</div></div>}</div>}</div></div>
