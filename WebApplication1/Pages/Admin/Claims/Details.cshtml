@page "{id}"
@using WebApplication1.Domain
@model WebApplication1.Pages.Admin.Claims.DetailsModel
@{
	ViewData["Title"] = "Claim verification";
}
@if (TempData["Message"] is string message){<div class="alert alert-success">@message</div>}
<div class="admin-page-header"><div><p class="eyebrow mb-1">Claim verification</p><h1 class="h2">Review claim @Model.Claim?.ClaimId</h1><p class="text-muted mb-0">Check the claimant's description against the item record before deciding.</p></div><a class="btn btn-outline-secondary" asp-page="/Admin/Index" asp-fragment="claims">Back to queue</a></div>
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
@if(Model.Claim is not null && Model.Item is not null){<div class="row g-4"><div class="col-lg-7"><section class="admin-section h-100"><div class="section-heading"><h2 class="h5 mb-0">Claim information</h2><span class="status-badge">@Model.Claim.Status</span></div><dl class="row mb-0"><dt class="col-sm-4">Claim ID</dt><dd class="col-sm-8">@Model.Claim.ClaimId</dd><dt class="col-sm-4">Claimant</dt><dd class="col-sm-8">@(Model.Claimant?.Name ?? Model.Claim.ClaimantId) <span class="text-muted">(@Model.Claim.ClaimantId)</span></dd><dt class="col-sm-4">Submitted</dt><dd class="col-sm-8">@Model.Claim.SubmittedDate.ToString("MMM d, yyyy h:mm tt")</dd><dt class="col-sm-4">Claim description</dt><dd class="col-sm-8"><div class="evidence-box">@Model.Claim.Description</div></dd>@if(Model.Claim.RejectionReason is not null){<dt class="col-sm-4">Rejection reason</dt><dd class="col-sm-8">@Model.Claim.RejectionReason</dd>}<dt class="col-sm-4">Reviewed by</dt><dd class="col-sm-8">@(Model.Claim.ReviewedBy ?? "Not yet reviewed")</dd><dt class="col-sm-4">Decision date</dt><dd class="col-sm-8">@(Model.Claim.ReviewDate?.ToString("MMM d, yyyy h:mm tt") ?? "Not decided")</dd></dl></section></div><div class="col-lg-5"><section class="admin-section mb-4"><div class="section-heading"><h2 class="h5 mb-0">Item record</h2><a asp-page="/Items/Details" asp-route-id="@Model.Item.ItemId">Open</a></div><h3 class="h5">@Model.Item.Name</h3><p class="text-muted">@Model.Item.ItemId · @Model.Item.Type · @Model.Item.Status</p><p>@Model.Item.Description</p><dl class="row small"><dt class="col-5">Category</dt><dd class="col-7">@Model.Item.Category</dd><dt class="col-5">Location</dt><dd class="col-7">@Model.Item.Location</dd></dl></section><section class="admin-section"><h2 class="h5">Administrator action</h2>@if(Model.Claim.Status == ClaimStatus.Pending){<form method="post" asp-page-handler="BeginReview"><button class="btn btn-primary w-100" onclick="return confirm('Start reviewing this claim?');">Start review</button></form>}else if(Model.Claim.Status == ClaimStatus.UnderReview){<form method="post" asp-page-handler="Decision"><input type="hidden" name="approve" value="true" /><div class="form-check mb-3"><input asp-for="ConfirmDecision" class="form-check-input" required /><label asp-for="ConfirmDecision" class="form-check-label">I verified the ownership information.</label></div><button class="btn btn-success w-100 mb-3" onclick="return confirm('Approve this claim?');">Approve claim</button></form><hr /><form method="post" asp-page-handler="Decision"><input type="hidden" name="approve" value="false" /><div class="mb-3"><label asp-for="RejectionReason" class="form-label">Rejection reason</label><textarea asp-for="RejectionReason" class="form-control" rows="3" required></textarea><span asp-validation-for="RejectionReason" class="text-danger"></span></div><div class="form-check mb-3"><input asp-for="ConfirmDecision" class="form-check-input" required /><label asp-for="ConfirmDecision" class="form-check-label">I confirm this rejection decision.</label></div><button class="btn btn-outline-danger w-100" onclick="return confirm('Reject this claim?');">Reject claim</button></form>}else{<div class="alert alert-light mb-0">This claim has already been decided. A staff member must still record the physical return separately after verification.</div>}</section></div></div>}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
