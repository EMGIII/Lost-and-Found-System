@page
@model WebApplication1.Pages.Account.RegisterModel
@{
	ViewData["Title"] = "Create account";
}
<div class="row justify-content-center"><div class="col-md-7 col-lg-6"><div class="card shadow-sm border-0"><div class="card-body p-4"><p class="eyebrow">Campus access</p><h1 class="h3">Create a new account</h1><p class="text-muted">Use your student number or faculty number as your sign-in identifier. Staff accounts are created by an administrator.</p><div asp-validation-summary="ModelOnly" class="text-danger"></div><form method="post"><div class="mb-3"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control" autocomplete="name" /><span asp-validation-for="Input.Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Role" class="form-label">Account type</label><select asp-for="Input.Role" class="form-select"><option value="">Select account type</option><option value="Student">Student</option><option value="Faculty">Faculty</option></select><span asp-validation-for="Input.Role" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Identifier" class="form-label"></label><input asp-for="Input.Identifier" class="form-control" placeholder="Student number or faculty number" /><span asp-validation-for="Input.Identifier" class="text-danger"></span></div><div class="row g-3"><div class="col-md-6"><label asp-for="Input.Password" class="form-label"></label><input asp-for="Input.Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Input.Password" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Input.ConfirmPassword" class="form-label"></label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div></div><button class="btn btn-primary w-100 mt-4">Create account</button></form><div class="text-center mt-3"><a asp-page="/Account/Login">Back to sign in</a></div></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }