@page
@model WebApplication1.Pages.Account.LoginModel
@{
	ViewData["Title"] = "Sign in";
}
<div class="row justify-content-center"><div class="col-md-6 col-lg-5"><div class="card shadow-sm border-0"><div class="card-body p-4"><div class="text-center mb-3"><img class="login-logo" src="~/images/school-logo.svg" alt="Infotech Development Systems Colleges logo" /></div><p class="eyebrow">Campus access</p><h1 class="h3">Sign in</h1><p class="text-muted">Use your student number, faculty number, or staff code.</p>@if (TempData["Message"] is string message){<div class="alert alert-success">@message</div>}<div asp-validation-summary="ModelOnly" class="text-danger"></div><form method="post"><input type="hidden" asp-for="ReturnUrl" /><div class="mb-3"><label asp-for="Input.Identifier" class="form-label"></label><input asp-for="Input.Identifier" class="form-control" autocomplete="username" /><span asp-validation-for="Input.Identifier" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Password" class="form-label"></label><input asp-for="Input.Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Input.Password" class="text-danger"></span></div><button class="btn btn-primary w-100">Sign in</button></form><div class="text-center mt-3"><span class="text-muted">New user?</span> <a asp-page="/Account/Register">Create a new account</a></div></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
