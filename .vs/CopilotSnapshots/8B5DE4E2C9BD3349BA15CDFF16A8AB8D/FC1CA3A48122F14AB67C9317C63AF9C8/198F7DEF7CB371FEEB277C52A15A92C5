using System.Security.Cryptography;
using Microsoft.AspNetCore.Identity;
using WebApplication1.Domain;

namespace WebApplication1.Infrastructure;

public sealed class JsonItemRepository(JsonFileStore<ItemRecord> store)
{
    public List<Item> Load() => store.Load().Select(ToDomain).ToList();

    public void Save(IEnumerable<Item> items) => store.Save(items.Select(ToRecord));

    private static Item ToDomain(ItemRecord record)
    {
        Item item = record.Type == ItemType.Lost
            ? new LostItem(record.ItemId, record.Name, record.Description, record.Category, record.Location, record.EventDate, record.DateReported, record.ReportedByUserId)
            : new FoundItem(record.ItemId, record.Name, record.Description, record.Category, record.Location, record.EventDate, record.DateReported, record.ReportedByUserId);
        item.RestoreStatus(record.Status);
        return item;
    }

    private static ItemRecord ToRecord(Item item) => new()
    {
        ItemId = item.ItemId,
        Type = item.Type,
        Name = item.Name,
        Description = item.Description,
        Category = item.Category,
        Location = item.Location,
        DateReported = item.DateReported,
        ReportedByUserId = item.ReportedByUserId,
        EventDate = item.Type == ItemType.Lost ? ((LostItem)item).DateLost : ((FoundItem)item).DateFound,
        Status = item.Status
    };
}

public sealed class JsonClaimRepository(JsonFileStore<ClaimRecord> store)
{
    public List<Claim> Load()
    {
        return store.Load().Select(record =>
        {
            var claim = new Claim(record.ClaimId, record.ItemId, record.ClaimantId, record.Description, record.SubmittedDate);
            claim.RestoreReview(record.Status, record.ReviewedBy, record.ReviewDate);
            return claim;
        }).ToList();
    }

    public void Save(IEnumerable<Claim> claims) => store.Save(claims.Select(claim => new ClaimRecord
    {
        ClaimId = claim.ClaimId,
        ItemId = claim.ItemId,
        ClaimantId = claim.ClaimantId,
        Description = claim.Description,
        Status = claim.Status,
        SubmittedDate = claim.SubmittedDate,
        ReviewedBy = claim.ReviewedBy,
        ReviewDate = claim.ReviewDate
    }));
}

public sealed record UserAccount(User User, string PasswordHash);

public sealed class JsonUserRepository(JsonFileStore<UserRecord> store, PasswordHasher<User> passwordHasher)
{
    public List<UserAccount> Load() => store.Load().Select(ToAccount).ToList();

    public void Save(IEnumerable<UserAccount> accounts) => store.Save(accounts.Select(account => ToRecord(account.User, account.PasswordHash)));

    public void SeedIfEmpty()
    {
        if (store.Load().Count > 0)
        {
            return;
        }

        var users = new User[]
        {
            new Student("student-001", "Emjay Reconday", "2026-0001"),
            new Faculty("faculty-001", "Demo Faculty", "FAC-001"),
            new Staff("staff-001", "Campus Staff", "STAFF-001")
        };
        Save(users.Select(user => new UserAccount(user, passwordHasher.HashPassword(user, "Demo123!"))));
    }

    private static UserAccount ToAccount(UserRecord record)
    {
        User user = record.Role switch
        {
            UserRole.Student => new Student(record.UserId, record.Name, record.Identifier),
            UserRole.Faculty => new Faculty(record.UserId, record.Name, record.Identifier),
            UserRole.Staff => new Staff(record.UserId, record.Name, record.Identifier),
            _ => throw new InvalidDataException($"Unsupported user role '{record.Role}'.")
        };
        return new UserAccount(user, record.PasswordHash);
    }

    private static UserRecord ToRecord(User user, string passwordHash) => new()
    {
        UserId = user.UserId,
        Name = user.Name,
        Role = user.Role,
        Identifier = user switch
        {
            Student student => student.StudentNumber,
            Faculty faculty => faculty.FacultyNumber,
            Staff staff => staff.StaffCode,
            _ => throw new InvalidDataException("Unsupported user type.")
        },
        PasswordHash = passwordHash
    };
}