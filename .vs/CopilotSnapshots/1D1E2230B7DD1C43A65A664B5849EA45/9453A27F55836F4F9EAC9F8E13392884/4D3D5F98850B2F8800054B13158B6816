<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Campus Lost and Found</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">Campus Lost &amp; Found</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Browse items</a>
                        </li>
                        @if (User.Identity?.Name?.Equals("001", StringComparison.OrdinalIgnoreCase) != true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Items/ReportLost">Report lost</a>
                            </li>
                            @if (User.IsInRole("Staff") || User.IsInRole("Student"))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-page="/Items/RegisterFound">Register found</a></li>
                            }
                        }
                        @if (User.IsInRole("Staff") || User.IsInRole("Student"))
                        {
                            @if (User.Identity?.Name?.Equals("001", StringComparison.OrdinalIgnoreCase) == true)
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-page="/Admin/Index">Admin dashboard</a></li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">@if (User.Identity?.IsAuthenticated == true){<span class="small text-muted">@User.Identity.Name</span><a class="btn btn-sm btn-outline-secondary" asp-page="/Account/Logout">Sign out</a>}else{<a class="btn btn-sm btn-primary" asp-page="/Account/Login">Sign in</a>}</div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
        &copy; 2026 - Campus Lost &amp; Found - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
