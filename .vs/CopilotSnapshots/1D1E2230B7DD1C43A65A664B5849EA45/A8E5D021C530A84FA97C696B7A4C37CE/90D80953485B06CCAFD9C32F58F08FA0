@page
@using WebApplication1.Domain
@model IndexModel
@{
	ViewData["Title"] = "Campus Lost and Found";
}

<div class="hero-panel rounded-4 p-4 p-md-5 mb-4">
	<div class="row align-items-center g-4"><div class="col-lg-7"><p class="eyebrow mb-2">Campus community service</p><h1 class="display-5 fw-bold">Find what matters. Return what belongs.</h1><p class="lead mb-0">Report lost belongings, register found items, and help verified owners reconnect with their property.</p></div><div class="col-lg-5 text-lg-end">@if (User.Identity?.Name?.Equals("001", StringComparison.OrdinalIgnoreCase) != true){<a class="btn btn-light btn-lg me-2" asp-page="/Items/ReportLost">Report lost item</a>@if (User.IsInRole("Staff") || User.IsInRole("Student")){<a class="btn btn-outline-light btn-lg" asp-page="/Items/RegisterFound">Register found</a>}}</div></div>
</div>
<form method="get" class="card shadow-sm border-0 mb-4"><div class="card-body"><div class="row g-3 align-items-end"><div class="col-md-4"><label asp-for="Query" class="form-label">Search</label><input asp-for="Query" class="form-control" placeholder="Name or description" /></div><div class="col-md-2"><label asp-for="Category" class="form-label">Category</label><select asp-for="Category" class="form-select"><option value="">All categories</option><option>Electronics</option><option>Clothing</option><option>Documents</option><option>Keys</option><option>Wallet or purse</option><option>Books and school supplies</option><option>Jewelry</option><option>Other</option></select></div><div class="col-md-2"><label asp-for="Location" class="form-label">Location</label><input asp-for="Location" class="form-control" /></div><div class="col-md-2"><label asp-for="Type" class="form-label">Type</label><select asp-for="Type" asp-items="Html.GetEnumSelectList<ItemType>()" class="form-select"><option value="">All types</option></select></div><div class="col-md-2 d-flex gap-2"><button class="btn btn-primary flex-grow-1" type="submit">Search</button><a class="btn btn-outline-secondary" asp-page="/Index">Clear</a></div></div></div></form>
<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Recent reports</h2><span class="text-muted">@Model.Results.Count record(s)</span></div>
@if (TempData["Message"] is string message){<div class="alert alert-success">@message</div>}
@if (Model.Results.Count == 0){<div class="empty-state text-center p-5 rounded-3"><h3 class="h5">No matching records</h3><p class="mb-0 text-muted">Try clearing a filter or check back after a new report is submitted.</p></div>}
else{<div class="row g-3">@foreach (var item in Model.Results){<div class="col-md-6 col-xl-4"><div class="card item-card h-100 shadow-sm border-0">@if (!string.IsNullOrWhiteSpace(item.ImageUrl)){<img src="@item.ImageUrl" class="card-img-top" alt="Photo of @item.Name" style="height: 180px; object-fit: cover;" />}<div class="card-body d-flex flex-column"><div class="d-flex justify-content-between gap-2"><span class="badge @(item.Type == ItemType.Found ? "text-bg-success" : "text-bg-warning")">@item.Type</span><span class="badge text-bg-light">@item.Status</span></div><h3 class="h5 mt-3">@item.Name</h3><p class="text-muted small mb-2">@item.Category · @item.Location</p>@if (Model.GetReporterDetails(item) is string reporterDetails){<p class="text-muted small mb-2"><strong>Reported by:</strong> @reporterDetails</p>}<p class="flex-grow-1">@item.Description</p><div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-page="/Items/Details" asp-route-id="@item.ItemId">View details</a>@if (User.Identity?.IsAuthenticated == true && item is FoundItem && item.Status == ItemStatus.Found){<a class="btn btn-primary" asp-page="/Claims/Create" asp-route-itemId="@item.ItemId">Submit claim</a>}</div></div></div></div>}}</div>}
