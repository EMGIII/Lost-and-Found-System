using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using WebApplication1.Application;
using WebApplication1.Domain;

namespace WebApplication1.Pages;

public class IndexModel(LostFoundManager manager) : PageModel
{
    public IReadOnlyList<Item> Results { get; private set; } = [];
    [BindProperty(SupportsGet = true)] public string? Query { get; set; }
    [BindProperty(SupportsGet = true)] public string? Category { get; set; }
    [BindProperty(SupportsGet = true)] public string? Location { get; set; }
    [BindProperty(SupportsGet = true)] public ItemType? Type { get; set; }

    public void OnGet() => Results = manager.SearchItems(new SearchCriteria { Query = Query, Category = Category, Location = Location, Type = Type });
}