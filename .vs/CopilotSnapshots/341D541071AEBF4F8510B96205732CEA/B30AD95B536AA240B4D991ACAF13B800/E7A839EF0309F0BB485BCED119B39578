@page
@model WebApplication1.Pages.Items.RegisterFoundModel
@{
	ViewData["Title"] = "Register a found item";
}
<h1>Register a found item</h1><p class="text-muted">This staff-only form records an item held for verification.</p>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form method="post" class="card shadow-sm border-0"><div class="card-body"><div class="row g-3"><div class="col-md-6"><label asp-for="Input.ItemId" class="form-label"></label><input asp-for="Input.ItemId" class="form-control" /><span asp-validation-for="Input.ItemId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Input.Category" class="form-label"></label><input asp-for="Input.Category" class="form-control" /><span asp-validation-for="Input.Category" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Input.Location" class="form-label"></label><input asp-for="Input.Location" class="form-control" /><span asp-validation-for="Input.Location" class="text-danger"></span></div><div class="col-12"><label asp-for="Input.Description" class="form-label"></label><textarea asp-for="Input.Description" class="form-control" rows="4"></textarea><span asp-validation-for="Input.Description" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Input.DateFound" class="form-label"></label><input asp-for="Input.DateFound" class="form-control" type="date" /><span asp-validation-for="Input.DateFound" class="text-danger"></span></div></div></div><div class="card-footer bg-white"><button class="btn btn-primary">Save found item</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
